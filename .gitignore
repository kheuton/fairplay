# dependencies / build
node_modules/
dist/
dist-ssr/

# cloudflare workers — local state, build temp, and local secrets (never commit)
.wrangler/
.dev.vars
worker/*/tmp/

# env & secrets — never commit tokens
.env
.env.*
*.local
# …except .env.production: a public, non-secret config (VITE_TODOIST_BASE only)
# that CI needs at build time. NEVER put a token here — it ships in the bundle.
!.env.production

# logs & tool state
logs/
*.log
.design-canvas.state.json
.thumbnail
_run.sh
