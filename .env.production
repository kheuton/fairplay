# Production build (npm run build / CI) talks DIRECTLY to the Todoist API, which
# is CORS-enabled — no dev proxy in production. Each user supplies their own token
# via the Settings page (stored in their browser's localStorage).
#
# DO NOT add VITE_TODOIST_API_TOKEN here or in CI: it would bake a personal token
# into the public JS bundle shipped to every visitor.
VITE_TODOIST_BASE=https://api.todoist.com
